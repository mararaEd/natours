extends base

block content
  main.main

    .card-container
      .create-tour
        i.fa.fa-plus-circle.btn-plus-circle 
        p.create-para tour
      each tour,i in tours
        .card  
          .card__header
            .card__picture 
              .card__picture-overlay &nbsp;
              img.card__picture-img(src=`/img/tours/${tour.imageCover}` alt=`${tour.name}`)
            h3.heading-tertirary
              span= tour.name

          .card__details
            h4.card__sub-heading=`${tour.difficulty} ${tour.duration}-day tour`
            p.card__text= tour.summary
            .card__data
              svg.card__icon: use(xlink:href='/img/icons.svg#icon-map-pin') 
              span= tour.startLocation.description
            .card__data
              svg.card__icon: use(xlink:href='/img/icons.svg#icon-calendar')
              //- each dateObj in tour.startDates
              - for (const el of tour.startDates) { if(el.date > Date.now()) var date= el.date; break; }
                span= date.toLocaleString('en-us', {month: 'long', year: 'numeric', day: 'numeric'})
            .card__data
              svg.card__icon: use(xlink:href='/img/icons.svg#icon-user')      
              span= `${tour.maxGroupSize} people`
            .card__data
              svg.card__icon: use(xlink:href='/img/icons.svg#icon-flag')      
              span= `${tour.locations.length} stops`

          .card__footer
            p
              span.card__footer--value=`$${tour.price}`
              |  
              span.card__footer--text per person
            p.card__ratings  
              span.card__footer--value= tour.ratingsAverage
              | 
              span.card__footer--text rating (#{tour.ratingsQuantity})
            .manage_buttons.manage-tours_button(data-pos=i data-id=tour._id)
              button.btn.btn--green.btn-customized.btn-manage_edit
                i.fa.fa-pencil
              button.btn.btn--green.btn-customized.btn-manage_delete
                i.fa.fa-trash-o


block popup
  .popup_container
    .popup_text.popup_manage
      .close-container.close-left: i.fa.fa-close
      button.btn.btn--green.btn-customized.popup_right
        i.fa.fa-check

