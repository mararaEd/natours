extends base

block content
  main.main
    if pleaseWait
        a.retry-me
        .error__title
          h2.heading-secondary.heading-secondary--error(style="color: green; text-transform: capitalize;") Please wait... 🤯
    else
      .error
        .error__title
          h2.heading-secondary.heading-secondary--error Uh oh! Something went wrong!   
          h2.error__emoji 😢 🤯
        .error__msg= msg
