header.header
    nav.nav.nav--tours
        a.nav__el(href='/') All tours
    .header__logo
        img(src='/img/logo-white.png' alt='Natours logo')
    nav.nav.nav--user
        - if (user)
            a.nav__el.nav__el--logout Log out
            a.nav__el.protected(href='/me')
                img.nav__user-img.old-photo(src=`/img/users/${user.photo}` alt= `photo of ${user.name}`)
                span= user.name.split(' ')[0]
        - else if(recheck)
            a.nav__el#reCheck(href='')
        - else
            a.nav__el(href='/login') Log in
            a.nav__el.nav__el--cta(href='/signup') Sign up





